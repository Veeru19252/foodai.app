# FoodAI — local environment
#
# Copy to `.env` and adjust. The backend does NOT read this file automatically
# (python-dotenv is not a dependency), so export the variables in your shell
# before starting uvicorn:
#
#     set -a && source .env && set -a
#     uvicorn backend.main:app --reload --port 8000
#
# Render sets these for you — see render.yaml. Never commit real secrets.

# --- Database ---------------------------------------------------------
# Local PostgreSQL 16. The default in backend/config.py is this exact string.
DATABASE_URL=postgresql+psycopg2://foodai:foodai_pass@127.0.0.1:5432/foodai

# --- Environment ------------------------------------------------------
# "production" enables fail-fast guards (JWT secret, Razorpay keys, demo
# seeding). Anything else is treated as development. Set this on Render.
ENVIRONMENT=development

# --- Auth -------------------------------------------------------------
# MUST be overridden for any shared deployment. Render generates this
# automatically (generateValue: true). Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app refuses to start if this is the default or < 32 chars.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS -------------------------------------------------------------
# Comma-separated. Must include the frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Phone OTP (pre-order verification gate) --------------------------
OTP_CODE_EXPIRE_MINUTES=5
OTP_JWT_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev-mode only: return the OTP code in the API response (no SMS provider).
# Defaults to on outside production and off in production.
OTP_DEV_MODE=true

# --- Delivery simulation ---------------------------------------------
# NOT configurable yet: the tick interval is the hardcoded constant
# SIM_INTERVAL_SECONDS in backend/simulation.py. Setting this variable has no
# effect (the CI workflow still sets one, harmlessly ignored).

# --- Frontend build-time (NOT read by the backend) --------------------
# Inlined into the browser bundle at `npm run build`, so changing it later
# requires a rebuild. Defaults to http://127.0.0.1:8000 when unset.
# NEXT_PUBLIC_API_URL=http://localhost:8000
